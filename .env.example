# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/medlout
JWT_SECRET=change-me-to-a-long-random-string        # old name JWT_SECRTKEY still works

# This account is always an admin (can manage staff). Must match an existing user's email.
ADMIN_EMAIL=you@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medlout

GROQ_API_KEY=

# OPTIONAL — password-reset emails. Leave empty if you don't send emails:
# admins then reset staff passwords from the Équipe page.
# Never put these in the code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Public address of the shop (used in password-reset emails)
FRONTEND_URL=https://front-med-lout.vercel.app
# Extra allowed CORS origins, comma separated (optional)
ALLOWED_ORIGINS=
