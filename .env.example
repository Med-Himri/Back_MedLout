# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/medlout
JWT_SECRET=change-me-to-a-long-random-string        # old name JWT_SECRTKEY still works

# This account is always an admin (can manage staff). Must match an existing user's email.
ADMIN_EMAIL=you@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medlout

GROQ_API_KEY=

# Emails: a notification for every new order (and password-reset links).
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com
#        SMTP_PASS=<16-letter App Password from myaccount.google.com/apppasswords>
# Without these, orders still arrive in the admin, just without an email.
# Never put these in the code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Who receives the new-order emails (comma separated). Defaults to ADMIN_EMAIL.
ORDER_NOTIFY_EMAIL=

# Public address of the shop (used in password-reset emails)
FRONTEND_URL=https://front-med-lout.vercel.app
# Extra allowed CORS origins, comma separated (optional)
ALLOWED_ORIGINS=
